Algoritmo "004"
// Disciplina  : Lógica de Programaçâo
// Professor   : Rodrigo 
// Descrição   : Descreva o que o programa faz
// Autor(a)    : Anthony Kildery
// Data atual  : 22/09/2026
Var
bloqueado: logico

Inicio
bloqueado <- falso

se nao bloqueado entao
   escreva("Acesso liberado!")
senao
   escreva("Acesso bloqueado!")
fimse

Fimalgoritmo
