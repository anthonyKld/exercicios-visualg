Algoritmo "003"
// Disciplina  : Lógica de Programaçâo
// Professor   : Rodrigo 
// Descrição   : Descreva o que o programa faz
// Autor(a)    : Anthony Kildery
// Data atual  : 26/11/2026
Var
base, altura: real

funcao calculaAreaTriangulo(b, h: real): real
inicio
      retorne (b * h) / 2
fimfuncao

Inicio
escreva("Digite o valor da base: ")
leia(base)
escreva("Digite o valor da altura: ")
leia(altura)
escreva("Valor da área: ", calculaAreaTriangulo(base, altura))

Fimalgoritmo
