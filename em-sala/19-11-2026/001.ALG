Algoritmo "001"
// Disciplina  : Lógica de Programaçâo
// Professor   : Rodrigo 
// Descrição   : Descreva o que o programa faz
// Autor(a)    : Anthony Kildery
// Data atual  : 19/11/2026
Var
nomeAluno: caractere
media: real

procedimento exibirCabecalho()
inicio
   escreval("FACULDADE CLARETIANO")
   escreval("---------------------")
   escreval("BOLETIM DO ALUNO")
   escreval("---------------------")
   escreval("")

fimprocedimento

Inicio
exibirCabecalho()

escreva("Digite o nome do aluno: ")
leia(nomeAluno)
escreva("Digite sua média final: ")
leia(media)
escreval("")
escreva("CADASTRO FEITO COM SUCESSO!")

Fimalgoritmo
