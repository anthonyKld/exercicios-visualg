Algoritmo "001-contagem_regressiva"
// Disciplina  : Lógica de Programaçâo
// Professor   : Rodrigo
// Descrição   : Descreva o que o programa faz
// Autor(a)    : Anthony Kildery
// Data atual  : 27/10/2026
Var
   numero: inteiro

Inicio
   numero <- 10

   repita
      escreval(numero)
      numero <- numero - 1
   ate (numero = 0)

Fimalgoritmo
