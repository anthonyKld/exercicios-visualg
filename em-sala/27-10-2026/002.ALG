Algoritmo "002"
// Disciplina  : Lógica de Programaçâo
// Professor   : Rodrigo 
// Descrição   : Descreva o que o programa faz
// Autor(a)    : Anthony Kildery
// Data atual  : 27/10/2026
Var
soma, numero: inteiro

Inicio

repita
      escreva("Digite um valor: ")
      leia(numero)
      soma <- soma + numero
ate numero = 0

escreva("Soma: ", soma)

Fimalgoritmo