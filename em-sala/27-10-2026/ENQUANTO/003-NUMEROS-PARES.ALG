Algoritmo "003-numeros-pares"
// Disciplina  : Lógica de Programação
// Professor   : Rodrigo
// Descrição   : Exibe os números pares de 1 até 20
// Autor(a)    : Anthony Kildery
// Data atual  : 27/10/2026
Var
   numero: inteiro

Inicio
   numero <- 2

   enquanto (numero <= 20) faca

      escreval(numero)

      numero <- numero + 2

   fimenquanto

Fimalgoritmo
